---
import "../styles/global.css";
import TopBar from "../components/layout/TopBar.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Breadcrumb from "../components/ui/Breadcrumb.astro";
import SchemaJsonLd from "../components/ui/SchemaJsonLd.astro";
import { business } from "../config/business";

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  breadcrumb?: BreadcrumbItem[];
  schemaJsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  noindex?: boolean;
}

const {
  title = `${business.name} — Menuiserie et agencement sur mesure dans les Mauges (49)`,
  description = "Malinge & Associés, menuisier et agenceur au Pin-en-Mauges (Beaupréau-en-Mauges) : portes, fenêtres, fermetures, pergolas, cuisines, dressings et mobilier sur mesure. Menuisier d'Excellence MéO, RGE Qualibat.",
  ogImage = "/og.jpg",
  breadcrumb,
  schemaJsonLd,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/png" href="/logo-icon-malinge.png" />
    <link rel="apple-touch-icon" href="/logo-icon-malinge.png" />

    {schemaJsonLd && <SchemaJsonLd data={schemaJsonLd} />}
    <noscript>
      <style>
        [data-reveal], .frise-card, .frise-badge, .frise-icon { opacity: 1 !important; transform: none !important; }
        [data-frise-line] { transform: none !important; }
      </style>
    </noscript>
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2 focus:bg-white focus:rounded-md focus:ring-2 focus:ring-[var(--color-accent)]"
    >
      Aller au contenu
    </a>
    <TopBar />
    <Header />
    {breadcrumb && breadcrumb.length > 0 && (
      <div class="border-b border-[var(--color-border)] bg-white">
        <div class="mx-auto w-full max-w-[90rem] px-5 sm:px-8 py-3">
          <Breadcrumb items={breadcrumb} />
        </div>
      </div>
    )}
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      // Apparition au scroll des éléments [data-reveal] (styles : global.css).
      // Sans JS ou en mouvement réduit, tout reste visible.
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const cibles = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if (reduced || !("IntersectionObserver" in window)) {
        cibles.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              const el = e.target as HTMLElement;
              el.style.setProperty("--reveal-delay", `${el.dataset.revealDelay ?? 0}ms`);
              el.classList.add("is-visible");
              io.unobserve(el);
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
        );
        cibles.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
