---
// Variante de hero « vidéo au défilement » (aperçu : /apercu/hero-video/).
// La vidéo ne se lit pas toute seule : c'est le défilement dans la section
// (300 vh) qui fait avancer `currentTime`. On part de la façade et de ses
// fenêtres, on entre dans la maison, on longe la cuisine et on arrive dans le
// salon devant la bibliothèque.
//
// Fichiers : public/hero/intro.mp4 (deux plans générés par IA — façade →
// cuisine, puis cuisine → salon — qui partagent la même image de jonction
// src/assets/hero-ia/cuisine.jpg, d'où un mouvement continu ; encodé avec une
// image clé toutes les 6 images pour que la recherche soit fluide) et
// public/hero/intro-poster.jpg.
// Sans JS ou en prefers-reduced-motion : affiche fixe, hauteur normale.
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import { business, agence } from "../../config/business";

// Légendes mises en avant selon l'avancement (0 → 1) dans la section. La vidéo
// (19,8 s, un seul mouvement de caméra) : façade et porte-fenêtre (0 → 8 s),
// cuisine (→ 15,5 s), salon et bibliothèque (→ fin).
const etapes = [
  { de: 0, a: 0.4, label: "Fenêtres et portes sur mesure" },
  { de: 0.4, a: 0.78, label: "Cuisine sur mesure" },
  { de: 0.78, a: 1, label: "Bibliothèque sur mesure" },
];
---

<section class="hero-video relative bg-[#14110d] text-white" data-hero-video>
  <div class="hero-video-cadre sticky top-[4.5rem] h-[calc(100svh-4.5rem)] overflow-hidden lg:top-20 lg:h-[calc(100svh-5rem)]">
    <video
      class="absolute inset-0 h-full w-full object-cover"
      muted
      playsinline
      preload="auto"
      poster="/hero/intro-poster.jpg"
      aria-hidden="true"
      data-video
    >
      <source src="/hero/intro.mp4" type="video/mp4" />
    </video>
    <div class="absolute inset-0 bg-gradient-to-t from-[#14110d]/80 via-[#14110d]/25 to-transparent" aria-hidden="true"></div>

    <Container width="wide" class="relative flex h-full flex-col justify-end pb-12 sm:pb-16">
      <div class="max-w-2xl will-change-transform" data-hero-copy>
        <p class="eyebrow !text-white/75">Menuiserie &amp; agencement · {agence.lieuDit} (49)</p>
        <h1 class="text-balance !text-white text-[clamp(2.25rem,5vw,3.75rem)]">
          Menuiserie et agencement <span class="text-[#a9cdeb]">sur mesure</span> dans les Mauges
        </h1>
        <p class="mt-5 max-w-xl text-[15px] leading-relaxed text-white/80 sm:text-[17px]">
          Depuis 2005, {business.name} conçoit, fabrique et pose vos portes, fenêtres, fermetures et protections
          solaires, et réalise cuisines, dressings et mobilier sur mesure.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="/contact/">Demander un devis gratuit</Button>
          <Button href="/produits/" variant="white" arrow={false}>Découvrir nos produits</Button>
        </div>
      </div>

      <ol class="mt-8 flex flex-wrap items-center gap-2" aria-hidden="true">
        {etapes.map((e) => (
          <li
            class="hero-video-etape rounded-full bg-white/10 px-3.5 py-1.5 text-[12px] font-medium text-white/70 ring-1 ring-white/20 backdrop-blur-md transition-all duration-300"
            data-etape
            data-de={e.de}
            data-a={e.a}
          >
            {e.label}
          </li>
        ))}
        <li class="ml-auto inline-flex items-center gap-1.5 text-[11px] uppercase tracking-[0.14em] text-white/60 transition-opacity duration-300" data-hero-indice>
          Faites défiler <Icon name="chevron" size={13} class="rotate-90" />
        </li>
      </ol>
    </Container>
  </div>
</section>

<style>
  .hero-video { height: 300vh; }
  .hero-video-etape.is-on {
    background: var(--color-accent);
    color: #fff;
    --tw-ring-color: transparent;
  }
  /* Sans animation (préférence système ou JS absent) : une seule hauteur d'écran, affiche fixe. */
  .hero-video.is-static { height: auto; }
  .hero-video.is-static .hero-video-cadre { position: relative; top: 0; }
  @media (prefers-reduced-motion: reduce) {
    .hero-video { height: auto; }
    .hero-video-cadre { position: relative; top: 0; }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>("[data-hero-video]");
  const video = section?.querySelector<HTMLVideoElement>("[data-video]");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (section && video && !reduced) {
    const etapes = Array.from(section.querySelectorAll<HTMLElement>("[data-etape]"));
    const copy = section.querySelector<HTMLElement>("[data-hero-copy]");
    const indice = section.querySelector<HTMLElement>("[data-hero-indice]");
    let duree = 0;
    let avancement = 0;
    let raf = 0;

    const mesurer = () => {
      const course = section.offsetHeight - window.innerHeight;
      const haut = section.getBoundingClientRect().top;
      return course > 0 ? Math.min(1, Math.max(0, -haut / course)) : 0;
    };

    const rendre = () => {
      raf = 0;
      const p = avancement;
      if (duree) video.currentTime = p * duree;
      for (const el of etapes) {
        el.classList.toggle("is-on", p >= Number(el.dataset.de) && p < Number(el.dataset.a) + (p === 1 ? 0.001 : 0));
      }
      if (copy) {
        // Le texte s'efface pendant le premier tiers pour laisser place à l'image.
        const t = Math.min(1, p / 0.4);
        copy.style.opacity = String(1 - t);
        copy.style.transform = `translateY(${-24 * t}px)`;
      }
      if (indice) indice.style.opacity = p > 0.05 ? "0" : "1";
    };

    const planifier = () => {
      avancement = mesurer();
      if (!raf) raf = requestAnimationFrame(rendre);
    };

    const pret = () => {
      duree = video.duration;
      video.pause();
      planifier();
    };
    if (video.readyState >= 1) pret();
    else video.addEventListener("loadedmetadata", pret, { once: true });

    window.addEventListener("scroll", planifier, { passive: true });
    window.addEventListener("resize", planifier);
    planifier();
  } else if (section) {
    section.classList.add("is-static");
  }
</script>
