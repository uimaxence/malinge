---
// La gamme MéO et l'extension de garantie, en tant que Menuisier d'Excellence.
// `compact` : version pour les pages produit (titre court, lien vers la page
// Menuisier d'Excellence). Sans `compact` : version complète de la page MéO.
import Container from "../ui/Container.astro";
import Icon from "../ui/Icon.astro";
import { meo } from "../../data/meo";
import { produits } from "../../data/produits";

interface Props {
  compact?: boolean;
  class?: string;
}
const { compact = false, class: className = "" } = Astro.props;

const nomProduit = (slug?: string) => produits.find((p) => p.slug === slug)?.nom;
---

<section class:list={["section-tight", className]} id="gamme-meo">
  <Container width="default">
    <div class="max-w-3xl" data-reveal>
      <p class="eyebrow">Menuisier d'Excellence MéO</p>
      <h2 class="text-balance">{compact ? "La gamme bois-aluminium MéO" : "Ce que nous posons chez MéO"}</h2>
      <p class="mt-4 text-base sm:text-lg text-[var(--color-muted)] leading-relaxed">{meo.presentation}</p>
    </div>

    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {meo.gamme.map((g, i) => (
        <li class="flex flex-col rounded-2xl bg-white ring-1 ring-[var(--color-border)] p-5 sm:p-6" data-reveal data-reveal-delay={String(i * 60)}>
          <p class="font-semibold text-[var(--color-fg)]">{g.nom}</p>
          <p class="mt-1.5 text-[14px] text-[var(--color-muted)] leading-relaxed">{g.texte}</p>
          <p class="mt-4 pt-4 border-t border-[var(--color-border)] flex flex-wrap gap-x-4 gap-y-1 text-[13px]">
            {g.produit && nomProduit(g.produit) && (
              <a href={`/produits/${g.produit}/`} class="inline-flex items-center gap-1 font-medium text-[var(--color-accent)] hover:underline">
                {nomProduit(g.produit)} chez nous <Icon name="arrow" size={12} />
              </a>
            )}
            <a href={g.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-[var(--color-muted)] hover:text-[var(--color-fg)]">
              Chez MéO <Icon name="external" size={12} />
            </a>
          </p>
        </li>
      ))}
      <li class="flex flex-col justify-between rounded-2xl bg-[var(--color-tint)] p-5 sm:p-6" data-reveal data-reveal-delay="300">
        <div>
          <p class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-[0.14em] text-[var(--color-accent)]">
            <Icon name="shield" size={13} /> Extension de garantie {meo.garantie.duree}
          </p>
          <p class="mt-2 text-[14px] leading-relaxed text-[var(--color-fg)]">{meo.garantie.texte}</p>
        </div>
        <a href={compact ? "/menuisier-excellence-meo/#garantie" : "#garantie"} class="mt-4 inline-flex items-center gap-1 text-[13px] font-medium text-[var(--color-accent)] hover:underline">
          Comment l'activer <Icon name="arrow" size={12} />
        </a>
      </li>
    </ul>

    {compact && (
      <p class="mt-8">
        <a href="/menuisier-excellence-meo/" class="inline-flex items-center gap-2 rounded-full border border-[var(--color-fg)] px-6 py-3 text-sm font-medium text-[var(--color-fg)] hover:bg-[var(--color-fg)] hover:text-white transition-colors">
          Ce que change le label Menuisier d'Excellence <Icon name="arrow" size={14} />
        </a>
      </p>
    )}
  </Container>
</section>
