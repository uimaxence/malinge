---
// Section avis Google. Tant que le Place ID n'est pas renseigné
// (src/config/business.ts), seul un encart « fiche Google » s'affiche :
// aucune note ni aucun avis inventés.
import Container from "../ui/Container.astro";
import Icon from "../ui/Icon.astro";
import { avisGlobal, avisGoogle } from "../../lib/avis";

interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;

const avisAffiches = avisGoogle.slice(0, 9);

function initiales(nom: string): string {
  return nom.split(/\s+/).filter(Boolean).slice(0, 2).map((m) => m[0]!.toUpperCase()).join("");
}
---

<section class:list={["section", className]}>
  <Container width="wide">
    <div class="text-center max-w-3xl mx-auto" data-reveal>
      <p class="eyebrow">Avis Google</p>
      <h2 class="text-balance">Ce que nos clients disent de nous</h2>

      <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
        <a
          href={avisGlobal.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 rounded-full border border-black/8 bg-white px-4 py-2 text-[13px] font-medium shadow-sm hover:shadow-md transition-shadow"
        >
          <Icon name="google" size={16} />
          {avisGlobal.disponible ? (
            <>
              <span class="flex text-amber-400" aria-hidden="true">
                {[1, 2, 3, 4, 5].map(() => <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg>)}
              </span>
              <span><strong>{avisGlobal.noteAffichee}/5</strong> · {avisGlobal.total} avis Google</span>
            </>
          ) : (
            <span>Voir notre fiche Google</span>
          )}
        </a>
        <span class="inline-flex items-center gap-2.5 rounded-full border border-black/8 bg-white px-4 py-2 text-[13px] font-medium shadow-sm">
          <Icon name="award" size={15} class="text-[var(--color-accent)]" />
          <span>Menuisier d'Excellence MéO</span>
        </span>
      </div>
    </div>

    {avisAffiches.length > 0 ? (
      <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3 items-start">
        {avisAffiches.map((avis) => (
          <article class="bg-[var(--color-tint)] rounded-2xl p-5 lg:p-6">
            <div class="flex items-center justify-between">
              <div class="flex text-amber-400" role="img" aria-label={`${avis.note} sur 5 étoiles`}>
                {Array.from({ length: avis.note }).map(() => <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg>)}
              </div>
              <Icon name="google" size={14} class="opacity-80" />
            </div>
            <p class="mt-3.5 text-[13.5px] leading-relaxed">{avis.texte}</p>
            <div class="mt-4 flex items-center gap-2.5">
              <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-[var(--color-accent)]/10 text-[var(--color-accent)] text-[11px] font-bold" aria-hidden="true">{initiales(avis.auteur)}</span>
              <span class="text-[13px] font-semibold">{avis.auteur}</span>
              {avis.dateRelative && <span class="ml-auto text-[11.5px] text-[var(--color-muted)]">{avis.dateRelative}</span>}
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="mt-10 mx-auto max-w-2xl rounded-2xl border border-dashed border-[var(--color-secondary)]/40 bg-[var(--color-tint-2)] p-6 text-center text-[14px] text-[var(--color-muted)]">
        <!-- TODO client : Place ID Google → les avis réels remplaceront cet encart. -->
        Les avis Google de nos clients s'afficheront ici automatiquement dès que la fiche Google Business sera reliée au site.
      </div>
    )}

    <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
      <a href={avisGlobal.mapsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center rounded-full px-6 py-2.5 text-[14px] font-medium text-white bg-[var(--color-accent)] hover:bg-[var(--color-accent-hover)] shadow-md transition-colors">
        {avisGlobal.disponible ? `Voir les ${avisGlobal.total} avis sur Google` : "Voir notre fiche Google"}
      </a>
      <a href={avisGlobal.writeReviewUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center rounded-full border border-[var(--color-accent)]/30 px-6 py-2.5 text-[14px] font-medium text-[var(--color-accent)] hover:bg-[var(--color-accent)]/5 transition-colors">
        Laisser un avis
      </a>
    </div>
  </Container>
</section>
