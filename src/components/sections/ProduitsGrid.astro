---
// Grille 4 × 2 des huit catégories (wireframe page d'accueil).
import { Image } from "astro:assets";
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Placeholder from "../ui/Placeholder.astro";
import Icon from "../ui/Icon.astro";
import { produits, POLES } from "../../data/produits";
import { imagesProduit } from "../../lib/media";

interface Props {
  /** Affiche l'en-tête de section (accueil) ou non (hub produits). */
  withHeading?: boolean;
  class?: string;
}
const { withHeading = true, class: className = "" } = Astro.props;

const cartes = produits.map((p) => ({
  ...p,
  image: imagesProduit(p.slug)[0],
}));
---

<section class:list={["section", className]}>
  <Container width="wide">
    {withHeading && (
      <SectionHeading
        eyebrow="Nos produits"
        title="Huit univers, <br class='hidden sm:block' />un seul interlocuteur"
        subtitle="De la porte d'entrée au dressing, nous concevons, fournissons et posons l'ensemble des menuiseries et agencements de votre maison."
        align="center"
        class="mb-12"
      />
    )}

    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {cartes.map((p, i) => (
        <li class="group" data-reveal data-reveal-delay={String((i % 4) * 90)}>
          <a
            href={`/produits/${p.slug}/`}
            class="flex h-full flex-col rounded-2xl bg-white ring-1 ring-[var(--color-border)] overflow-hidden hover:shadow-lg hover:-translate-y-1 transition-all duration-200"
          >
            <div class="relative aspect-[4/3] overflow-hidden">
              {p.image ? (
                <Image
                  src={p.image}
                  alt={`${p.nom} — Malinge & Associés`}
                  widths={[400, 600, 800]}
                  sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw"
                  loading="lazy"
                  decoding="async"
                  format="webp"
                  quality={78}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              ) : (
                <Placeholder label={`Photo ${p.nom}`} ratio="4-3" rounded={false} class="h-full" />
              )}
              <span class="absolute top-3 left-3 inline-flex items-center rounded-full bg-white/90 backdrop-blur px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--color-secondary)]">
                {POLES[p.pole].label}
              </span>
            </div>
            <div class="flex flex-1 flex-col p-5">
              <div class="flex items-center gap-2.5">
                <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-[var(--color-tint)] text-[var(--color-accent)]">
                  <Icon name={p.icone} size={15} />
                </span>
                <h3 class="text-[17px] font-semibold">{p.nom}</h3>
              </div>
              <p class="mt-3 text-[13px] text-[var(--color-muted)] leading-relaxed">
                {p.sousProduits.map((s) => s.nom).join(" · ")}
              </p>
              <span class="mt-auto pt-4 inline-flex items-center gap-1.5 text-[13px] font-medium text-[var(--color-accent)] group-hover:gap-2.5 transition-all">
                Découvrir <Icon name="arrow" size={13} />
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </Container>
</section>
