---
// Emplacement visuel en attendant les photos du client. Remplacé
// automatiquement dès qu'une image existe dans le dossier concerné
// (voir src/lib/media.ts).
type Ratio = "16-9" | "4-3" | "1-1" | "3-4" | "21-9" | "auto";
type Kind = "image" | "video" | "logo";

interface Props {
  label?: string;
  ratio?: Ratio;
  kind?: Kind;
  class?: string;
  rounded?: boolean;
}

const { label = "Photo à venir", ratio = "16-9", kind = "image", class: className = "", rounded = true } = Astro.props;

const ratioMap: Record<Ratio, string> = {
  "16-9": "aspect-video",
  "4-3": "aspect-[4/3]",
  "1-1": "aspect-square",
  "3-4": "aspect-[3/4]",
  "21-9": "aspect-[21/9]",
  auto: "",
};
---

<div
  class:list={[
    "relative flex items-center justify-center overflow-hidden bg-[var(--color-tint-2)] border border-dashed border-[var(--color-secondary)]/40",
    ratioMap[ratio],
    rounded && "rounded-2xl",
    className,
  ]}
  role="img"
  aria-label={label}
>
  <div class="flex flex-col items-center gap-2 px-4 text-center text-[var(--color-secondary)]">
    {kind === "logo" ? (
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z" /><circle cx="7.5" cy="7.5" r="1.5" />
      </svg>
    ) : (
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="5" width="18" height="14" rx="2" /><circle cx="9" cy="10" r="1.5" /><path d="m21 15-4.5-4.5L9 18" />
      </svg>
    )}
    <span class="text-[11px] sm:text-xs font-medium tracking-wide uppercase max-w-[28ch]">{label}</span>
  </div>
</div>
