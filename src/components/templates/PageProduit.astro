---
// Gabarit des pages /produits/<slug>/ : hero, galerie auto, sous-produits,
// contenu, configurateur MéO (portes d'entrée), gamme MéO (fenêtres, portes),
// réalisations liées, CTA.
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Container from "../ui/Container.astro";
import Placeholder from "../ui/Placeholder.astro";
import Icon from "../ui/Icon.astro";
import MeoConfigurateur from "../sections/MeoConfigurateur.astro";
import MeoGamme from "../sections/MeoGamme.astro";
import ContactForm from "../sections/ContactForm.astro";
import type { Produit } from "../../data/produits";
import { POLES } from "../../data/produits";
import { imagesProduit, imagesRealisation } from "../../lib/media";
import { telephones, toE164 } from "../../config/business";

interface Props {
  produit: Produit;
}
const { produit } = Astro.props;

const images = imagesProduit(produit.slug);
const [couverture, ...galerie] = images;
const tel = telephones[produit.pole];

const realisations = (await getCollection("realisations", ({ data }) => !data.draft && data.produits.includes(produit.slug)))
  .sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0))
  .slice(0, 3)
  .map((r) => ({ ...r, cover: imagesRealisation(r.id)[0] }));
---

<section class="section-tight">
  <Container width="default">
    <p class="eyebrow">{POLES[produit.pole].label} · {POLES[produit.pole].sousTitre}</p>
    <h1 class="text-balance max-w-3xl">{produit.titre}</h1>
    <p class="mt-6 max-w-2xl text-[17px] leading-relaxed text-[var(--color-muted)]">{produit.description}</p>
    {produit.materiaux && (
      <ul class="mt-6 flex flex-wrap gap-2">
        {produit.materiaux.map((m) => (
          <li class="inline-flex items-center rounded-full bg-[var(--color-tint)] px-3.5 py-1.5 text-[13px] font-medium text-[var(--color-accent)]">{m}</li>
        ))}
      </ul>
    )}
  </Container>
</section>

<section class="pb-12">
  <Container width="default">
    {couverture ? (
      <div class="rounded-3xl overflow-hidden ring-1 ring-[var(--color-border)]">
        <Image src={couverture} alt={`${produit.nom} — réalisation Malinge & Associés`} widths={[640, 960, 1280]} sizes="(max-width: 1280px) 100vw, 1280px" loading="eager" decoding="async" format="webp" quality={82} class="w-full h-auto aspect-[16/9] object-cover" />
      </div>
    ) : (
      <Placeholder label={`Photo principale — src/assets/produits/${produit.slug}/`} ratio="21-9" />
    )}
  </Container>
</section>

<section class="pb-16">
  <Container width="default">
    <div class="grid lg:grid-cols-[1fr_320px] gap-10 items-start">
      <div class="prose-ma">
        {produit.contenu.map((p) => <p>{p}</p>)}
        <!-- TODO client : enrichir le contenu de chaque catégorie (gammes, marques, options). -->
        <h2>Nos solutions</h2>
        <ul class="!pl-0 grid sm:grid-cols-2 gap-4 !list-none">
          {produit.sousProduits.map((s) => (
            <li class="!pl-0 !m-0 rounded-2xl bg-white ring-1 ring-[var(--color-border)] p-5 before:hidden">
              <p class="font-semibold text-[var(--color-fg)] !m-0">{s.nom}</p>
              {s.texte && <p class="!mt-1.5 !mb-0 text-[14px]">{s.texte}</p>}
            </li>
          ))}
        </ul>
      </div>

      <aside class="lg:sticky lg:top-28 rounded-2xl bg-[var(--color-tint-2)] p-6">
        <p class="eyebrow !text-[var(--color-secondary)]">Votre contact</p>
        <p class="font-semibold">{tel.contact}</p>
        <a href={`tel:${toE164(tel.numero)}`} class="mt-3 inline-flex items-center gap-2 text-[18px] font-display font-semibold text-[var(--color-accent)]">
          <Icon name="phone" size={17} /> {tel.numero}
        </a>
        <p class="mt-4 text-[13px] text-[var(--color-muted)] leading-relaxed">Devis gratuit, prise de cotes à domicile, conseil au showroom du Pin-en-Mauges.</p>
        <a href="#contact" class="mt-5 inline-flex w-full items-center justify-center rounded-full px-5 py-2.5 text-[14px] font-medium text-white bg-[var(--color-accent)] hover:bg-[var(--color-accent-hover)] transition-colors">Demander un devis</a>
      </aside>
    </div>
  </Container>
</section>

{produit.configurateurMeo && <MeoConfigurateur class="!pt-0" />}

{produit.gammeMeo && <MeoGamme compact class={produit.configurateurMeo ? "" : "!pt-0"} />}

{galerie.length > 0 && (
  <section class="section-tight bg-[var(--color-subtle)]">
    <Container width="wide">
      <p class="eyebrow text-center">Galerie</p>
      <h2 class="text-center mb-10">En images</h2>
      <!-- Colonnes (et non grille recadrée) : les photos en portrait (portes, fenêtres) restent entières. -->
      <ul class="columns-1 sm:columns-2 lg:columns-3 gap-4">
        {galerie.map((img, i) => (
          <li class="mb-4 break-inside-avoid overflow-hidden rounded-xl ring-1 ring-[var(--color-border)] bg-white">
            <Image src={img} alt={`${produit.nom} — vue ${i + 2}`} widths={[400, 700, 1000]} sizes="(max-width: 1024px) 50vw, 33vw" loading="lazy" decoding="async" format="webp" quality={78} class="w-full h-auto" />
          </li>
        ))}
      </ul>
    </Container>
  </section>
)}

{realisations.length > 0 && (
  <section class="section-tight">
    <Container width="wide">
      <p class="eyebrow">Réalisations</p>
      <h2 class="mb-8">Nos chantiers {produit.nom.toLowerCase()}</h2>
      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {realisations.map((r) => (
          <li>
            <a href={`/realisations/${r.id}/`} class="group block rounded-2xl overflow-hidden bg-white ring-1 ring-[var(--color-border)] hover:shadow-lg hover:-translate-y-1 transition-all">
              {r.cover ? (
                <Image src={r.cover} alt={r.data.title} widths={[400, 700]} sizes="(max-width: 1024px) 50vw, 33vw" loading="lazy" decoding="async" format="webp" quality={78} class="w-full aspect-[4/3] object-cover transition-transform duration-500 group-hover:scale-105" />
              ) : (
                <Placeholder label="Photo réalisation" ratio="4-3" rounded={false} />
              )}
              <div class="p-5">
                <p class="text-[11px] uppercase tracking-[0.14em] text-[var(--color-accent)] font-semibold">{r.data.location}{r.data.year ? ` · ${r.data.year}` : ""}</p>
                <h3 class="mt-2 text-[16px] group-hover:text-[var(--color-accent)] transition-colors">{r.data.title}</h3>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </Container>
  </section>
)}

<ContactForm projet={produit.slug} />
