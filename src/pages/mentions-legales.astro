---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import { business, addressOneLine, telephones, toE164 } from "../config/business";
---

<BaseLayout title={`Mentions légales — ${business.name}`} description={`Mentions légales du site ${business.url}.`} noindex>
  <section class="section pt-16 lg:pt-20">
    <Container width="narrow">
      <h1>Mentions légales</h1>
      <div class="mt-10 space-y-8 text-[var(--color-muted)] leading-relaxed">
        <div>
          <h2 class="text-2xl">Éditeur</h2>
          <p class="mt-3">
            {business.legalName} ({business.legalForm})<br />
            {addressOneLine()}<br />
            {/* TODO client : SIREN / SIRET, capital social, n° TVA, directeur de publication. */}
            SIREN : à compléter — SIRET : à compléter<br />
            Téléphone : <a href={`tel:${toE164(telephones.menuiserie.numero)}`} class="text-[var(--color-accent)] hover:underline">{telephones.menuiserie.numero}</a><br />
            Email : <a href={`mailto:${business.email}`} class="text-[var(--color-accent)] hover:underline">{business.email}</a>
          </p>
        </div>
        <div>
          <h2 class="text-2xl">Hébergement</h2>
          <p class="mt-3">Vercel Inc. — 440 N Barranca Ave #4133, Covina, CA 91723, États-Unis — <a href="https://vercel.com" target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent)] hover:underline">vercel.com</a></p>
        </div>
        <div>
          <h2 class="text-2xl">Propriété intellectuelle</h2>
          <p class="mt-3">L'ensemble du contenu du site (textes, images, logos) est protégé par le droit d'auteur et le droit des marques. Toute reproduction sans autorisation préalable est interdite.</p>
        </div>
        <div id="donnees" class="scroll-mt-24">
          <h2 class="text-2xl">Données personnelles</h2>
          <p class="mt-3">Les informations recueillies via le formulaire de contact sont utilisées exclusivement pour traiter votre demande. Conformément au RGPD, vous disposez d'un droit d'accès, de rectification et de suppression de vos données en écrivant à <a href={`mailto:${business.email}`} class="text-[var(--color-accent)] hover:underline">{business.email}</a>. Le site n'utilise pas de cookies de suivi.</p>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
