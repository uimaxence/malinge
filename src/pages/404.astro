---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";

const liens = [
  { label: "Nos produits", href: "/produits/" },
  { label: "Nos réalisations", href: "/realisations/" },
  { label: "Zones d'intervention", href: "/zones-intervention/" },
  { label: "Nous contacter", href: "/contact/" },
];
---

<BaseLayout title="Page introuvable (404) — Malinge & Associés" description="La page demandée n'existe pas ou a été déplacée." noindex>
  <section class="section pt-16 lg:pt-24 text-center">
    <Container width="narrow">
      <p class="eyebrow">Erreur 404</p>
      <h1 class="mt-3 text-balance">Cette page est introuvable</h1>
      <p class="mt-5 text-base sm:text-lg text-[var(--color-muted)] leading-relaxed">La page que vous cherchez a peut-être été déplacée ou n'existe plus.</p>
      <div class="mt-8 flex justify-center">
        <a href="/" class="inline-flex items-center rounded-full px-6 py-3 text-sm font-medium text-white bg-[var(--color-accent)] hover:bg-[var(--color-accent-hover)] shadow-sm transition-colors">Retour à l'accueil</a>
      </div>
      <ul class="mt-10 flex flex-wrap justify-center gap-x-6 gap-y-3 text-sm">
        {liens.map((l) => <li><a href={l.href} class="text-[var(--color-accent)] hover:underline">{l.label}</a></li>)}
      </ul>
    </Container>
  </section>
</BaseLayout>
