---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";
import Placeholder from "../../components/ui/Placeholder.astro";
import CTASection from "../../components/sections/CTASection.astro";
import { imagesRealisation } from "../../lib/media";
import { getProduit } from "../../data/produits";

const realisations = (await getCollection("realisations", ({ data }) => !data.draft))
  .sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0))
  .map((r) => ({ ...r, cover: imagesRealisation(r.id)[0] }));

const title = "Nos réalisations — Chantiers de menuiserie et d'agencement dans les Mauges | Malinge & Associés";
const description =
  "Reportages photo MéO, chantiers SyBaie, cuisines et mobilier sur mesure : découvrez les réalisations de Malinge & Associés à Beaupréau-en-Mauges, Cholet et dans tout le Choletais.";
const breadcrumb = [{ label: "Accueil", href: "/" }, { label: "Réalisations" }];
---

<BaseLayout title={title} description={description} breadcrumb={breadcrumb}>
  <section class="section-tight">
    <Container width="default">
      <p class="eyebrow">Réalisations</p>
      <h1 class="text-balance max-w-3xl">Nos chantiers de menuiserie et d'agencement</h1>
      <p class="mt-6 max-w-2xl text-[16px] text-[var(--color-muted)] leading-relaxed">
        Reportages photo de nos partenaires, chantiers récents, publications : un aperçu concret de notre travail
        dans les Mauges et le Choletais.
      </p>
    </Container>
  </section>

  <section class="pb-16">
    <Container width="wide">
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {realisations.map((r, i) => (
          <li>
            <a href={`/realisations/${r.id}/`} class="group block h-full rounded-2xl overflow-hidden bg-white ring-1 ring-[var(--color-border)] hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
              <div class="relative aspect-[4/3] overflow-hidden">
                {r.cover ? (
                  <Image src={r.cover} alt={`${r.data.title}, ${r.data.location} — Malinge & Associés`} widths={[400, 700, 1000]} sizes="(max-width: 1024px) 50vw, 33vw" loading={i < 3 ? "eager" : "lazy"} decoding="async" format="webp" quality={78} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                ) : (
                  <Placeholder label={`Photos — src/assets/realisations/${r.id}/`} ratio="4-3" rounded={false} class="h-full" />
                )}
                {r.data.source && (
                  <span class="absolute top-3 left-3 rounded-full bg-white/90 backdrop-blur px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--color-secondary)]">{r.data.source}</span>
                )}
              </div>
              <div class="p-6">
                <p class="text-[11px] uppercase tracking-[0.14em] text-[var(--color-accent)] font-semibold">{r.data.location}{r.data.year ? ` · ${r.data.year}` : ""}</p>
                <h3 class="mt-2 group-hover:text-[var(--color-accent)] transition-colors">{r.data.title}</h3>
                {r.data.description && <p class="mt-3 text-sm text-[var(--color-muted)] leading-relaxed line-clamp-3">{r.data.description}</p>}
                {r.data.produits.length > 0 && (
                  <ul class="mt-4 flex flex-wrap gap-1.5">
                    {r.data.produits.map((slug) => getProduit(slug)).filter(Boolean).map((p) => (
                      <li class="rounded-full bg-[var(--color-tint)] px-2.5 py-1 text-[11px] font-medium text-[var(--color-accent)]">{p!.nom}</li>
                    ))}
                  </ul>
                )}
              </div>
            </a>
          </li>
        ))}
      </ul>
    </Container>
  </section>

  <CTASection eyebrow="Votre projet" title="Et si votre maison était la prochaine ?" secondaryLabel="Visiter le showroom" secondaryHref="/entreprise/#showroom" />
</BaseLayout>
