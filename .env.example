# Variables d'environnement du site Malinge & Associés
# Copier ce fichier en `.env` et renseigner les valeurs.

# Clé d'accès Web3Forms (formulaire de contact).
# À créer gratuitement sur https://web3forms.com avec l'email de réception
# (contact@malingeassocies.fr). Sur Vercel : Settings → Environment Variables.
PUBLIC_WEB3FORMS_KEY=

# Clé Google Places API (New) pour récupérer les avis Google au build.
# Facultatif : sans clé, le build garde src/data/avis-google.json tel quel.
GOOGLE_PLACES_API_KEY=
